<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="event"
            type="com.northcoders.eventapp.model.Event" />

        <variable
            name="clickHandler"
            type="com.northcoders.eventapp.ui.create.EventCreateClickHandler"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#34A853">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Info"
            android:textColor="@color/white"
            android:textSize="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/nameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:text="Name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            android:layout_marginStart="20dp"
            android:layout_marginTop="35dp"
            />

        <EditText
            android:id="@id/nameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:ems="10"
            android:backgroundTint="@color/white"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="25dp"
            android:text="@={event.name}"
            />

        <TextView
            android:id="@+id/descriptionView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:text="Description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameView"
            android:layout_marginStart="20dp"
            android:layout_marginTop="50dp"

            />

        <EditText
            android:id="@+id/descriptionBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:ems="10"
            android:backgroundTint="@color/white"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@+id/nameBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="25dp"
            android:text="@={event.description}"
            />

        <TextView
            android:id="@+id/dateView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:text="Date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionView"
            android:layout_marginStart="20dp"
            android:layout_marginTop="50dp"
            />

        <EditText
            android:id="@+id/dateBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:ems="10"
            android:backgroundTint="@color/white"
            android:inputType="date"
            app:layout_constraintTop_toBottomOf="@+id/descriptionBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="25dp"
            android:text="@={event.date}"
            />

        <TextView
            android:id="@+id/timeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:text="Time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dateView"
            android:layout_marginStart="20dp"
            android:layout_marginTop="45dp"
            />

        <EditText
            android:id="@+id/timeBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:ems="10"
            android:backgroundTint="@color/white"
            android:inputType="time"
            app:layout_constraintTop_toBottomOf="@+id/dateBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="25dp"
            android:text="@={event.time}"
            />

        <TextView
            android:id="@+id/locationView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:text="Location"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/timeView"
            android:layout_marginStart="20dp"
            android:layout_marginTop="45dp"
            />

        <EditText
            android:id="@+id/locationBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:ems="10"
            android:backgroundTint="@color/white"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@+id/timeBox"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="25dp"
            android:text="@={event.location}"
            />

        <Button
            android:id="@+id/createButton"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginTop="65dp"
            android:backgroundTint="@color/white"
            android:onClick="@{clickHandler.createEvent}"
            android:text="Create"
            android:textColor="#34A853"
            android:textSize="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/locationView"
            />







    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>