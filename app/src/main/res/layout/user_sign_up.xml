<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#34A853"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up to EventsApp"
            android:textColor="@color/white"
            android:textSize="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <EditText
            android:id="@+id/nameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/first_nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Name"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="100dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/last_nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Name"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/first_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="180dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/lastNameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="170dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/birthDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birth Date"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="260dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/phoneNumberBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="date"
            app:layout_constraintTop_toBottomOf="@id/lastNameBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="250dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/dateBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            app:layout_constraintTop_toBottomOf="@id/phoneNumberBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="320dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/usernameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="330dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/passwordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="410dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/emailAddressBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/dateBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="400dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <Button
            android:id="@+id/signUpbutton"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:text="Sign Up"
            android:textSize="15dp"
            android:layout_marginTop="60dp"
            android:textColor="#34A853"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:backgroundTint="@color/white"
            app:layout_constraintTop_toBottomOf="@id/passwordLabel"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>