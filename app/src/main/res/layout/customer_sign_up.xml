<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="customer"
            type="com.northcoders.eventapp.model.Customer"
            />

        <variable
            name="clickHandler"
            type="com.northcoders.eventapp.ui.signup.CustomerClickHandler" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#34A853">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up to EventsApp"
            android:textColor="@color/white"
            android:textSize="35dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <EditText
            android:id="@+id/nameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@={customer.first_name}"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/first_nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Name"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="100dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/last_nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Name"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/first_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="180dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/lastNameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@={customer.last_name}"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="170dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/birthDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birth Date"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="260dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/birthDateBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="date"
            android:text="@={customer.birth_date}"
            app:layout_constraintTop_toBottomOf="@id/lastNameBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="250dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/usernameBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:text="@={customer.username}"
            app:layout_constraintTop_toBottomOf="@id/birthDateBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="400dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/emailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="330dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/usernameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="400dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/passwordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/last_nameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="480dp"
            android:layout_marginStart="25dp"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/emailbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@={customer.emailAddress}"
            app:layout_constraintTop_toBottomOf="@id/birthDateBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="320dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <EditText
            android:id="@+id/passwordBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:text="@={customer.password}"
            app:layout_constraintTop_toBottomOf="@id/birthDateBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="480dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/white"
            />

        <Button
            android:id="@+id/signUpbutton"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginTop="65dp"
            android:backgroundTint="@color/white"
            android:onClick="@{clickHandler::signUpCustomer}"
            android:text="Sign Up"
            android:textColor="#34A853"
            android:textSize="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/passwordLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>